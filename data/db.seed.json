{
  "_schema": {
    "relationships": {
      "user -> contacts": "one-to-many (saved attendees, owned by a user)",
      "user -> eventGroups": "one-to-many",
      "eventGroup -> events": "one-to-many (user can create multiple events per group)",
      "event <-> hosts": "many-to-many via eventHosts (an event can have multiple hosts)",
      "event <-> attendees": "many-to-many via eventAttendees (max 6 per event)"
    },
    "constraints": {
      "event.maxAttendees": 6,
      "eventAttendees": "count per eventId must be <= 6",
      "eventAttendees.source": "'contact' (picked from saved attendees, uses contactId) or 'guest' (added ad hoc, uses guestName/guestEmail)",
      "eventHosts": "unique (eventId, hostId); at least 1 host per event"
    }
  },

